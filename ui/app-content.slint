import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { BrowserPicker } from "views/browser-picker.slint";
import { VideoFeed } from "views/video-feed.slint";
import { VideoPlayer } from "views/video-player.slint";
import { SettingsPage } from "views/settings.slint";
import { AppLoading } from "components/app-loading.slint";
import { NavRail } from "components/nav-rail.slint";
import { SyncMenu } from "components/sync-menu.slint";
import { SearchBar } from "components/search-bar.slint";
import { ActionButton } from "components/action-button.slint";
import { Avatar } from "components/avatar.slint";
import { Icon } from "components/icon.slint";
import { MenuItem, MenuSurface } from "components/menu-item.slint";
export component AppContent inherits Rectangle {
    callback switch-profile(int);
    switch-profile(index) => { AppState.switch-profile(index); }
    callback remove-profile(int);
    remove-profile(index) => { AppState.remove-profile(index); }
    private property <bool> narrow: root.width < 700px;
    private property <int> other-profiles: max(0, AppState.saved-profiles.length - (AppState.active-profile >= 0 && AppState.active-profile < AppState.saved-profiles.length ? 1 : 0));
    // Space kept clear for the floating search bar. Feeds scroll underneath it.
    private property <length> inset: 24px + 48px + 32px;
    private property <int> active: AppState.settings-open ? 7 : AppState.view-kind;
    init => { app-keys.focus(); }
    // Saved-profile index awaiting a second click to remove, or -2.
    private property <int> confirm-remove: -2;
    private property <bool> menu-open: AppState.account-menu-open;
    changed menu-open => { root.confirm-remove = -2; }
    private property <bool> player-active: AppState.player-open;
    changed player-active => { if !root.player-active { app-keys.focus(); } }
    function navigate(kind: int) {
        app-keys.focus();
        AppState.account-menu-open = false;
        AppState.sync-menu-open = false;
        AppState.player-sidebar-open = false;
        if AppState.player-open { AppState.player-close(); }
        if root.active == kind && !AppState.settings-open { AppState.scroll-reset += 1; return; }
        AppState.settings-open = kind == 7;
        if kind == 0 { AppState.load-feed(false); }
        else if kind == 1 { AppState.load-feed(true); }
        else if kind == 3 { AppState.open-playlists(); }
        else if kind == 9 { AppState.open-bookmarks(); }
        else if kind == 5 { AppState.open-subscriptions(false); }
    }
    private property <int> clipboard-serial: AppState.clipboard-serial;
    changed clipboard-serial => { clipboard.select-all(); clipboard.copy(); }
    clipboard := TextInput { text: AppState.clipboard-text; visible: false; }
    background: Theme.background;
    forward-focus: app-keys;
    app-keys := FocusScope {
    if AppState.initializing : AppLoading {}
    if AppState.player-open : VideoPlayer {
        close => { AppState.player-breadcrumb(-1); }
        toggle => { AppState.player-toggle(); }
        seek(value) => { AppState.player-seek(value); }
        volume-changed(value) => { AppState.player-volume-changed(value); }
        toggle-fullscreen => { AppState.player-toggle-fullscreen(); }
        retry => { AppState.player-retry(); }
        select-quality(index) => { AppState.player-select-quality(index); }
        select-subtitle(index) => { AppState.player-select-subtitle(index); }
    }
    // The profile picker is a page of its own, without the rail or search bar.
    if !AppState.initializing && !AppState.player-open && AppState.setup-open : BrowserPicker {}
    if !AppState.initializing && !AppState.player-open && !AppState.setup-open : Rectangle {
        if !root.narrow : NavRail { x: 0px; y: 0px; width: 80px; height: parent.height; active: root.active; navigate(kind) => { root.navigate(kind); } }
        if root.narrow : NavRail { y: parent.height - 72px; width: parent.width; height: 72px; horizontal: true; active: root.active; navigate(kind) => { root.navigate(kind); } }
        FocusScope {
            x: root.narrow ? 0px : 80px; y: 0px;
            width: parent.width - self.x; height: parent.height - (root.narrow ? 72px : 0px);
            VerticalLayout {
                padding-top: AppState.settings-open ? root.inset : 0px;
                padding-left: root.narrow ? 16px : 32px; padding-right: root.narrow ? 16px : 32px; padding-bottom: 0px;
                if AppState.settings-open : SettingsPage {}
                if !AppState.settings-open : VideoFeed { top-inset: root.inset; }
            }
            HorizontalLayout {
                y: 24px; height: 48px; padding-left: root.narrow ? 16px : 32px; padding-right: self.padding-left; alignment: center;
                search := SearchBar { width: min(600px, parent.width - parent.padding-left * 2); }
            }
        }
    }
    if AppState.player-sidebar-open && AppState.player-open : Rectangle {
        background: #00000099;
        TouchArea { clicked => { AppState.player-sidebar-open = false; } }
        NavRail { x: 0px; y: 0px; width: 80px; height: parent.height; active: root.active; navigate(kind) => { root.navigate(kind); } }
    }
    if AppState.sync-menu-open && !AppState.initializing && !AppState.setup-open : Rectangle {
        TouchArea { clicked => { AppState.sync-menu-open = false; } }
        sync-menu := SyncMenu {
            x: root.narrow ? max(8px, parent.width - self.width - 8px) : 72px;
            y: max(8px, parent.height - self.height - (root.narrow ? 72px : 68px));
            running: AppState.sync-running; complete: AppState.sync-complete; failed: AppState.sync-failed;
            count: AppState.sync-count; status: AppState.sync-title; detail: AppState.sync-detail; warning: AppState.sync-warning;
            can-sync: AppState.connected && !AppState.busy && !AppState.refreshing;
            sync-now => { AppState.reload(false); }
        }
    }
    if AppState.account-menu-open && !AppState.initializing && !AppState.setup-open : Rectangle {
        TouchArea { clicked => { AppState.account-menu-open = false; } }
        account-menu := MenuSurface {
            x: root.narrow ? max(8px, parent.width - self.width - 8px) : 72px;
            y: parent.height - self.height - (root.narrow ? 72px : 14px);
            width: 260px; height: account-layout.preferred-height; border-radius: 14px;
            TouchArea {}
            account-layout := VerticalLayout { padding: 6px; spacing: 0px;
                HorizontalLayout { padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 10px; spacing: 11px; cross-axis-alignment: center;
                    Avatar { width: 36px; initials: AppState.account-initial; tone: #26262c; url: AppState.account-avatar; }
                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                        account-name := Text { text: AppState.account-name; accessible-role: text; accessible-label: self.text; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                        account-source := Text { text: AppState.account-label; accessible-role: text; accessible-label: self.text; color: Theme.muted; font-size: 12px; overflow: elide; }
                    }
                    Rectangle {
                        width: synced-layout.preferred-width; height: 22px; border-radius: 11px; background: #4ade801a;
                        accessible-role: text; accessible-label: "Synced"; accessible-description: AppState.watch-note;
                        synced-layout := HorizontalLayout { padding-left: 9px; padding-right: 9px; spacing: 6px; cross-axis-alignment: center;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.success; }
                            Text { text: "Synced"; color: #86efac; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 1px;
                    Rectangle { x: 4px; width: parent.width - 8px; height: 1px; background: #26262c; }
                }
                Rectangle { height: 4px; }
                if root.other-profiles > 0 : ScrollView {
                    height: min(208px, root.other-profiles * 52px);
                    content-width: self.visible-width;
                    VerticalLayout { spacing: 0px;
                        for profile[index] in AppState.saved-profiles : Rectangle {
                            height: index == AppState.active-profile ? 0px : 52px;
                            vertical-stretch: 0;
                            if index != AppState.active-profile : Rectangle {
                                property <bool> confirming: root.confirm-remove == index;
                                border-radius: 8px;
                                background: profile-touch.has-hover || self.confirming ? Theme.raised : transparent;
                                accessible-role: button;
                                accessible-label: profile.name;
                                accessible-description: profile.label;
                                accessible-enabled: !AppState.busy && !self.confirming;
                                accessible-action-default => { if !AppState.busy && !self.confirming { root.switch-profile(index); } }
                                // Under the row content so the remove buttons stay clickable.
                                profile-touch := TouchArea {
                                    enabled: !AppState.busy && !parent.confirming; mouse-cursor: pointer;
                                    clicked => { root.switch-profile(index); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 4px; spacing: 11px; cross-axis-alignment: center;
                                    Avatar { width: 32px; initials: profile.initials; url: profile.avatar; tone: #26262c; accessible-role: none; }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: root.confirm-remove == index ? "Remove " + profile.name + "?" : profile.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: root.confirm-remove != index ? profile.label : profile.pasted ? "Its saved cookies are deleted." : "Your browser isn't changed."; color: Theme.muted; font-size: 11px; overflow: elide; }
                                    }
                                    if root.confirm-remove != index : remove-profile := Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px;
                                        opacity: profile-touch.has-hover || remove-touch.has-hover || remove-focus.has-focus || root.narrow ? 1 : 0;
                                        background: remove-touch.has-hover ? #2e2e35 : transparent;
                                        border-width: remove-focus.has-focus ? 1px : 0px; border-color: #7aa2ff;
                                        accessible-role: button; accessible-label: "Remove " + profile.name;
                                        accessible-action-default => { root.confirm-remove = index; }
                                        Icon { name: "close"; width: 14px; height: 14px; tint: Theme.muted; }
                                        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.confirm-remove = index; } }
                                        remove-focus := FocusScope {
                                            key-pressed(event) => {
                                                if event.text == " " || event.text == "\n" { root.confirm-remove = index; return accept; }
                                                return reject;
                                            }
                                        }
                                    }
                                    if root.confirm-remove == index : HorizontalLayout { spacing: 2px;
                                        ActionButton { text: "Cancel"; quiet: true; height: 30px; clicked => { root.confirm-remove = -2; } }
                                        confirm-remove-profile := ActionButton { text: "Remove"; outlined: true; height: 30px; enabled: !AppState.busy;
                                            clicked => { root.confirm-remove = -2; root.remove-profile(index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if AppState.active-profile >= 0 && root.confirm-remove != AppState.active-profile : remove-current := MenuItem {
                    text: "Remove this profile"; icon: "close"; min-height: 44px;
                    clicked => { root.confirm-remove = AppState.active-profile; }
                }
                if AppState.active-profile >= 0 && root.confirm-remove == AppState.active-profile : HorizontalLayout {
                    padding-left: 12px; padding-right: 4px; padding-top: 6px; padding-bottom: 6px; spacing: 4px;
                    Text {
                        horizontal-stretch: 1; text: "Remove " + AppState.account-name + "? You'll choose another profile.";
                        color: Theme.text; font-size: 12.5px; wrap: word-wrap; vertical-alignment: center;
                        accessible-role: text; accessible-label: self.text;
                    }
                    VerticalLayout { alignment: center;
                        HorizontalLayout { spacing: 2px;
                            ActionButton { text: "Cancel"; quiet: true; height: 30px; clicked => { root.confirm-remove = -2; } }
                            confirm-remove-current := ActionButton { text: "Remove"; outlined: true; height: 30px; enabled: !AppState.busy;
                                clicked => { root.confirm-remove = -2; root.remove-profile(AppState.active-profile); }
                            }
                        }
                    }
                }
                change-browser := MenuItem { text: "Change browser"; icon: "globe"; trailing-chevron: true; min-height: 44px;
                    clicked => { AppState.change-browser(); }
                }
            }
        }
    }
    if AppState.toast != "" : Rectangle { x: (parent.width - self.width) / 2; y: parent.height - 72px; width: min(parent.width - 32px, toast-text.preferred-width + 36px); height: 42px; background: Theme.strong; border-radius: 24px;
        toast-text := Text { text: AppState.toast; color: Theme.background; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    Timer { interval: 3500ms; running: AppState.toast != ""; triggered => { AppState.toast = ""; } }
    KeyBinding { keys: @keys(Slash); enabled: !AppState.player-open && !AppState.initializing && !AppState.setup-open; activated => { AppState.search-focus-serial += 1; } }
    KeyBinding { keys: @keys(Escape); enabled: !AppState.initializing && !AppState.setup-open && (!AppState.player-open || AppState.sync-menu-open); activated => { AppState.sync-menu-open = false; AppState.account-menu-open = false; if !AppState.player-open { AppState.search-text = ""; app-keys.focus(); } } }
    }
}
