import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { MenuItem, MenuSurface } from "menu-item.slint";
// Rounded dropdown that opens a popover of options with a tick on the current one.
export component Choice inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    in property <string> label;
    callback selected(int);
    min-width: max(150px, value.preferred-width + 54px);
    preferred-width: self.min-width;
    max-width: self.min-width;
    height: 40px;
    horizontal-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #3a3a44 : Theme.border;
    background: Theme.raised;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.options[root.current-index];
    accessible-action-default => { popup.show(); }
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 10px;
        cross-axis-alignment: center;
        value := Text { horizontal-stretch: 1; text: root.options[root.current-index]; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
        Icon { name: "down"; width: 16px; height: 16px; tint: Theme.subtle; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0px; y: root.height + 6px;
        width: max(root.width, 180px); height: menu.preferred-height;
        MenuSurface {
            width: parent.width; height: menu.preferred-height;
            menu := VerticalLayout {
                padding: 6px; spacing: 0px;
                for option[index] in root.options : MenuItem {
                    text: option; checked: index == root.current-index;
                    clicked => { root.current-index = index; root.selected(index); popup.close(); }
                }
            }
        }
    }
}
