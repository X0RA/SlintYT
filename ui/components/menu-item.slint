import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
// One row of a popover menu: label, optional detail line, and a tick for the current choice.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> icon;
    in property <bool> checked: false;
    in property <bool> trailing-chevron: false;
    callback clicked();
    min-height: root.detail == "" ? 38px : 52px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
        cross-axis-alignment: center;
        if root.icon != "" : Icon { name: root.icon; width: 18px; height: 18px; tint: Theme.muted; }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 2px;
            Text { text: root.text; color: Theme.text; font-size: 13px; font-weight: root.checked ? 600 : 400; overflow: elide; }
            if root.detail != "" : Text { text: root.detail; color: Theme.subtle; font-size: 11px; overflow: elide; }
        }
        if root.checked : Icon { name: "check"; width: 16px; height: 16px; tint: Theme.text; }
        if root.trailing-chevron : Icon { name: "chevron"; width: 16px; height: 16px; tint: #71717a; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Popover surface shared by the menus.
export component MenuSurface inherits Rectangle {
    background: #17171b;
    border-width: 1px; border-color: #26262c; border-radius: 12px;
    drop-shadow-color: #0000008c; drop-shadow-blur: 40px; drop-shadow-offset-y: 16px;
}
