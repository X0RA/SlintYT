import { AppState } from "../state.slint";
import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { TwitchChat } from "twitch-chat.slint";

// The outer surface is the player's bounds. Only the small chat frame captures input.
export component TwitchChatOverlay inherits Rectangle {
    in property <bool> preview: false;
    in property <image> mock-image;
    private property <bool> editing: hover.has-hover || drag.pressed || resize.pressed;
    frame := Rectangle {
        width: min(root.width, max(160px, AppState.chat-overlay-width * 1px));
        height: min(root.height, max(140px, AppState.chat-overlay-height * 1px));
        x: max(0px, min(root.width - self.width, AppState.chat-overlay-x * root.width));
        y: max(0px, min(root.height - self.height, AppState.chat-overlay-y * root.height));
        border-radius: 6px;
        background: root.editing ? #11111499 : transparent;
        border-width: root.editing ? 1px : 0px; border-color: #ffffff44;
        // An ancestor TouchArea tracks hover over the list and controls without stealing scrolling.
        hover := TouchArea {
            TwitchChat {
                x: 3px; y: 34px; width: parent.width - 6px; height: parent.height - 48px;
                floating: true; controls-visible: root.editing;
                preview: root.preview; mock-image: root.mock-image;
            }
            toolbar := Rectangle {
                visible: root.editing;
                x: 1px; y: 1px; width: parent.width - 2px; height: 32px;
                background: #141417ee; border-radius: 5px;
                Text { x: 10px; width: parent.width - 86px; text: "Drag chat"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                drag := TouchArea {
                    x: 0px; y: 0px; width: parent.width - 72px; height: parent.height;
                    mouse-cursor: move;
                    accessible-role: button; accessible-label: "Move chat";
                    moved => {
                        if self.pressed {
                            AppState.chat-overlay-x = max(0px, min(root.width - frame.width, frame.x + self.mouse-x - self.pressed-x)) / max(1px, root.width);
                            AppState.chat-overlay-y = max(0px, min(root.height - frame.height, frame.y + self.mouse-y - self.pressed-y)) / max(1px, root.height);
                        }
                    }
                }
                dock := Rectangle {
                    x: parent.width - 68px; y: 0px; width: 32px; height: 32px;
                    accessible-role: button; accessible-label: "Dock chat to the side";
                    accessible-action-default => { AppState.chat-floating = false; AppState.chat-follow = true; }
                    Icon { name: "chat-panel"; width: 20px; height: 20px; tint: dock-touch.has-hover ? white : Theme.muted; }
                    dock-touch := TouchArea { mouse-cursor: pointer; clicked => { AppState.chat-floating = false; AppState.chat-follow = true; } }
                }
                close := Rectangle {
                    x: parent.width - 34px; y: 0px; width: 32px; height: 32px;
                    accessible-role: button; accessible-label: "Close floating chat";
                    accessible-action-default => { AppState.chat-open = false; }
                    Icon { name: "close"; width: 24px; height: 24px; tint: close-touch.has-hover ? Theme.accent : Theme.muted; }
                    close-touch := TouchArea { mouse-cursor: pointer; clicked => { AppState.chat-open = false; } }
                }
            }
            grip := Rectangle {
                visible: root.editing;
                x: parent.width - 20px; y: parent.height - 20px; width: 20px; height: 20px;
                Icon { name: "resize"; width: 18px; height: 18px; tint: resize.has-hover || resize.pressed ? white : Theme.muted; }
                resize := TouchArea {
                    mouse-cursor: nwse-resize;
                    accessible-role: button; accessible-label: "Resize chat";
                    moved => {
                        if self.pressed {
                            AppState.chat-overlay-width = min(root.width - frame.x, max(160px, frame.width + self.mouse-x - self.pressed-x)) / 1px;
                            AppState.chat-overlay-height = min(root.height - frame.y, max(140px, frame.height + self.mouse-y - self.pressed-y)) / 1px;
                        }
                    }
                }
            }
        }
    }
}
