import { Theme } from "../theme.slint";
import { AppState, TwitchResult } from "../state.slint";
import { Avatar } from "avatar.slint";
export component TwitchResultRow inherits Rectangle {
    in property <TwitchResult> item;
    in property <bool> user: false;
    in property <bool> narrow: false;
    callback activate();
    private property <length> thumb-width: root.narrow ? 120px : 192px;
    // Goes through the avatar downloader, which also caches on disk.
    private property <image> thumbnail: AppState.avatar-image(root.user ? "" : root.item.picture, AppState.avatar-epoch);
    height: root.user ? 105px : root.thumb-width * 9 / 16 + 32px;
    background: touch.has-hover ? #121215 : transparent;
    accessible-role: button; accessible-label: root.item.title; accessible-action-default => { root.activate(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activate(); } }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.row; }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: root.narrow ? 12px : 20px; cross-axis-alignment: center;
        if root.user : Avatar { width: 72px; initials: root.item.initials; tone: root.item.tone; url: root.item.picture; accessible-role: none; }
        if !root.user : Rectangle {
            width: root.thumb-width; height: self.width * 9 / 16; border-radius: 12px; background: Theme.raised; clip: true;
            Image { source: root.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
            if root.item.duration != "" : Rectangle {
                x: parent.width - self.width - 8px; y: parent.height - self.height - 8px;
                width: duration.preferred-width + 12px; height: 20px; background: #0a0a0bc7; border-radius: 5px;
                duration := Text { text: root.item.duration; color: white; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 6px;
            Text { text: root.item.title; color: Theme.text; font-size: root.narrow ? 14px : 16px; font-weight: 500; overflow: elide; }
            Text { text: root.item.subtitle; color: Theme.muted; font-size: 13px; overflow: elide; }
            if root.item.metadata != "" : Text { text: root.item.metadata; color: Theme.subtle; font-size: 13px; overflow: elide; }
        }
    }
}
