import { TwitchChannelCard } from "../components/twitch-channel-card.slint";
import { AppState } from "../state.slint";
import { Button } from "std-widgets.slint";
export { AppState, BrowserProfile, VideoData, FeedSection, CommentData, Breadcrumb, LinkData, TwitchResult, TwitchRecent, TwitchFollow } from "../state.slint";
export component AppWindow inherits Window { title: "twitch-channel-card preview"; preferred-width: 820px; height: 450px; background: #0e0e10; init => { AppState.twitch-recent = [{ query: "speedrun" }, { query: "A very long recent search for an archived broadcast" }]; AppState.twitch-video-total = 420; AppState.twitch-channel-total = 120; } VerticalLayout { padding: 24px; spacing: 16px; HorizontalLayout { spacing: 12px; TwitchChannelCard { item: { id: "runner", title: "A channel with a long display name", stats: "2.1M followers", metadata: "Speedruns and more", initials: "RU", tone: #4b3ab3 }; following: false; } TwitchChannelCard { item: { id: "runner", title: "A channel with a long display name", stats: "2.1M followers", metadata: "Speedruns and more", initials: "RU", tone: #4b3ab3 }; following: true; } } Rectangle { vertical-stretch: 1; } Button { text: "Empty"; clicked => { AppState.twitch-recent = []; AppState.twitch-video-total = 0; AppState.twitch-channel-total = 0; } } } }
