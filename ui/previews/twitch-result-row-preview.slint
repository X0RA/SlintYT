import { TwitchResultRow } from "../components/twitch-result-row.slint";
export { AppState, BrowserProfile, VideoData, FeedSection, CommentData, Breadcrumb, LinkData, TwitchResult } from "../state.slint";
export component AppWindow inherits Window {
    in-out property <bool> mock-bookmarked: true;
    title: "Twitch result row preview";
    preferred-width: 800px; height: 480px; background: #0e0e10;
    VerticalLayout { padding: 24px; alignment: start;
        TwitchResultRow { item: { id: "1", title: "Any% world record attempts", subtitle: "GamesDoneQuick", metadata: "Celeste · 12.5K views · 2026-11-04", duration: "1:50:31" }; }
        // Bookmarked and 40% watched. The bookmark button toggles the mock state.
        TwitchResultRow { item: { id: "2", title: "Half watched and bookmarked", subtitle: "Runner", metadata: "Celeste · 980 views · 2026-11-01", duration: "5:49:48" }; progress: 40; bookmarked: root.mock-bookmarked; bookmark-toggle => { root.mock-bookmarked = !root.mock-bookmarked; } }
        TwitchResultRow { item: { id: "3", title: "Finished", subtitle: "Runner", metadata: "Celeste · 2 views · 2026-10-30", duration: "12:04" }; progress: 100; }
        TwitchResultRow { item: { title: "A very long video title that should elide because it does not fit inside the available width of this row at all", subtitle: "A channel with a long name", metadata: "No game listed · 1 view · 2026-01-02" }; }
        TwitchResultRow { user: true; item: { title: "GamesDoneQuick", subtitle: "@gamesdonequick · 2.1M followers", metadata: "Replay of the marathon", initials: "GD", tone: #3b4a63 }; }
        TwitchResultRow { user: true; item: { title: "quietstreamer", subtitle: "@quietstreamer · 1 follower", initials: "QS", tone: #4a3a3a }; }
    }
}
