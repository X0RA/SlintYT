// Discovered profiles arrive grouped by browser: `first` starts a group, whose
// header uses `group`, `initials`, `tone` and `root`. Saved profiles leave these empty.
export struct BrowserProfile { label: string, path: string, name: string, avatar: string, initials: string, group: string, root: string, tone: color, first: bool, temporary: bool }
export struct VideoData {
    id: string, title: string, channel: string, metadata: string,
    duration: string, thumbnail: image, playlist: bool, watched: int, watch-progress: int,
    channel-id: string, initials: string, tone: color, avatar: string, group: string, set-id: string, subscribed: bool,
}
export struct FeedSection { label: string, detail: string, start: int, count: int }
export struct CommentData { id: string, author: string, author-id: string, initials: string, avatar: string, text: string, metadata: string, likes: string, replies: int, token: string, indent: int, expanded: bool, liked: bool, can-like: bool }
export struct Breadcrumb { id: string, title: string, position: float, playlist-index: int }
export struct LinkData { title: string, url: string }

export global AppState {
    in-out property <bool> initializing: true;
    in-out property <bool> setup-open: true;
    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <bool> refreshing: false;
    in-out property <bool> has-more: false;
    in-out property <int> view-kind: 0;
    in-out property <string> page-title: "Recommended for you";
    in-out property <string> page-subtitle: "A home feed from your YouTube account";
    in-out property <string> watch-note;
    in-out property <bool> sync-menu-open: false;
    in-out property <bool> sync-running: false;
    in-out property <bool> sync-complete: false;
    in-out property <bool> sync-failed: false;
    in-out property <string> sync-count: "0";
    in-out property <string> sync-title: "Not synced yet";
    in-out property <string> sync-detail;
    in-out property <string> sync-warning;
    in-out property <string> search-text;
    in-out property <string> playlist-input;
    in-out property <string> account-label;
    in-out property <string> account-name: "YouTube profile";
    in-out property <string> account-browser: "Browser session";
    in-out property <string> account-profile;
    in-out property <string> account-initial: "?";
    in-out property <string> account-avatar;
    // Avatars are downloaded on first use. Bumping the epoch re-reads them once one arrives.
    in-out property <int> avatar-epoch;
    pure callback avatar-image(string, int) -> image;
    in-out property <string> status;
    in-out property <string> error;
    in-out property <string> scan-warning;
    in-out property <[BrowserProfile]> profiles;
    // Picker row preselected by Rust (the profile in use), or -1.
    in-out property <int> selected-profile: -1;
    in-out property <int> temporary-profiles;
    in-out property <string> manual-profile-path;
    in-out property <bool> profile-dialog-open;
    callback browse-profile-folder();
    // Start-up splash: 0 reading the browser session, 1 connecting to YouTube, 2 loading the feed.
    in-out property <int> startup-step;
    in-out property <bool> startup-failed;
    in-out property <string> startup-label;
    in-out property <string> startup-initial;
    callback retry-startup();
    callback change-browser();
    in-out property <[BrowserProfile]> saved-profiles;
    in-out property <int> active-profile: -1;
    callback switch-profile(int);
    in-out property <[VideoData]> videos;
    in-out property <[FeedSection]> sections;
    in-out property <int> feed-columns: 3;
    callback reflow-feed(int);
    pure callback matches(string, string) -> bool;
    pure callback channel-count([VideoData], string, bool) -> int;
    in-out property <int> scroll-reset: 0;
    in-out property <bool> settings-open: false;
    callback open-data-folder();
    // Enabled only by the macOS tool manager (or standalone mock previews).
    in-out property <bool> managed-tools: false;
    in-out property <bool> tools-busy: false;
    in-out property <bool> tools-error: false;
    in-out property <string> tools-status;
    in-out property <string> tools-versions;
    callback check-tool-updates();
    in-out property <bool> account-menu-open: false;
    in-out property <bool> player-sidebar-open: false;
    in-out property <string> toast;
    in-out property <string> clipboard-text;
    in-out property <int> clipboard-serial;
    in-out property <int> search-focus-serial;
    in-out property <int> dismiss-popovers;
    in-out property <string> channel-id;
    in-out property <string> channel-name;
    in-out property <string> channel-initials: "?";
    in-out property <string> channel-avatar;
    in-out property <color> channel-tone: #3b4a63;
    in-out property <string> channel-meta;
    in-out property <string> channel-description;
    in-out property <image> channel-banner;
    in-out property <[LinkData]> channel-links;
    in-out property <bool> channel-has-live: true;
    in-out property <bool> channel-subscribed: false;
    in-out property <int> channel-tab: 0;
    in-out property <int> channel-sort: 0;
    in-out property <string> channel-query;
    in-out property <string> channel-filter;
    in-out property <bool> action-busy: false;
    in-out property <string> current-playlist;
    in-out property <bool> playlist-shuffle: false;
    in-out property <[VideoData]> save-playlists;
    in-out property <string> player-video-id;
    in-out property <int> player-playlist-index: -1;
    in-out property <string> player-origin: "Home";
    in-out property <[Breadcrumb]> breadcrumbs;
    in-out property <string> player-channel;
    in-out property <string> player-channel-id;
    in-out property <string> player-channel-initials: "?";
    in-out property <string> player-channel-avatar;
    in-out property <color> player-channel-tone: #3b4a63;
    in-out property <string> player-stats;
    in-out property <string> player-description;
    in-out property <styled-text> player-rich-description;
    in-out property <bool> player-subscribed: false;
    in-out property <bool> player-liked: false;
    in-out property <bool> details-loading: false;
    in-out property <string> details-error;
    in-out property <[VideoData]> recommendations;
    in-out property <[CommentData]> comments;
    in-out property <bool> comments-loading: false;
    in-out property <bool> comments-more: false;
    in-out property <string> comments-error;
    in-out property <bool> comments-newest: false;
    in-out property <string> comment-draft;
    in-out property <int> player-detail-tab: 0;
    in-out property <float> player-speed: 1;
    in-out property <float> player-buffered;
    in-out property <bool> player-muted: false;
    in-out property <bool> player-pip: false;
    in-out property <bool> player-open: false;
    in-out property <bool> player-loading: false;
    in-out property <bool> player-paused: false;
    in-out property <bool> player-buffering: false;
    in-out property <bool> player-ended: false;
    in-out property <bool> player-fullscreen: false;
    in-out property <string> player-title;
    in-out property <string> player-error;
    in-out property <string> player-progress-note;
    in-out property <image> player-texture;
    in-out property <float> player-width;
    in-out property <float> player-height;
    in-out property <float> player-position;
    in-out property <float> player-duration;
    in-out property <float> player-volume: 70;
    in-out property <[string]> player-qualities;
    in-out property <[string]> player-quality-details;
    in-out property <int> player-quality-index: 0;
    in-out property <bool> player-qualities-loading: false;
    in-out property <string> player-quality-note;
    in-out property <[string]> player-subtitles: ["Off"];
    in-out property <int> player-subtitle-index: 0;
    in-out property <bool> player-subtitles-loading: false;
    in-out property <string> player-subtitle-note;
    callback play-video(string, string);
    callback player-close();
    callback player-toggle();
    callback player-seek(float);
    callback player-volume-changed(float);
    callback player-toggle-fullscreen();
    callback player-retry();
    callback player-select-quality(int);
    callback player-select-subtitle(int);
    callback open-subscriptions(bool);
    callback open-channel(string, int, int, string);
    callback load-video-details(string);
    callback load-comments(bool, bool);
    callback load-replies(string, bool);
    callback submit-comment(string, string);
    callback toggle-subscription(string, bool);
    callback toggle-like();
    callback toggle-comment-like(string);
    callback save-video(string);
    callback edit-playlist(int, int);
    callback play-playlist();
    callback play-playlist-entry(int);
    callback player-next();
    callback player-breadcrumb(int);
    callback player-set-speed(float);
    callback player-toggle-mute();
    callback player-toggle-pip();
    callback copy-link(string);
    callback open-url(string);
    callback follow-video-link(string);
    callback scan-profiles();
    callback connect-profile(int, int);
    callback connect-manual(string, string, int);
    callback load-feed(bool);
    callback search(string);
    callback open-playlists();
    callback open-playlist(string);
    callback reload(bool);
}
