    in-out property <string> startup-pasted-path;
    in-out property <string> startup-pasted-name;
    // Text, name and the replace-target path ("" for a new profile).
    callback connect-pasted(string, string, string);
    // Connects a saved pasted profile by its vault path.
    callback connect-saved-path(string);
