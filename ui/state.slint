// Discovered profiles arrive grouped by browser: `first` starts a group, whose
// header uses `group`, `initials`, `tone` and `root`. Saved profiles leave these empty.
// `pasted` marks a saved profile made from pasted cookies.
export struct BrowserProfile { label: string, path: string, name: string, avatar: string, initials: string, group: string, root: string, tone: color, first: bool, temporary: bool, pasted: bool, selection-key: string }
export struct VideoData {
    id: string, title: string, channel: string, metadata: string,
    duration: string, thumbnail: image, playlist: bool, watched: int, watch-progress: int,
    channel-id: string, initials: string, tone: color, avatar: string, group: string, set-id: string, subscribed: bool,
}
export struct FeedSection { label: string, detail: string, start: int, count: int, header-index: int, collapsed: bool }
export struct CommentData { id: string, author: string, author-id: string, initials: string, avatar: string, text: string, metadata: string, likes: string, replies: int, token: string, indent: int, expanded: bool, liked: bool, can-like: bool }
export struct Breadcrumb { id: string, title: string, position: float, playlist-index: int }
export struct LinkData { title: string, url: string }
// Videos also carry their channel, "268 views · 1 day ago", game and kind
// ("Highlight", when known), plus the channel's avatar. Channels use `stats`
// for their follower count.
export struct TwitchResult { id: string, title: string, subtitle: string, metadata: string, duration: string, picture: string, initials: string, tone: color, channel: string, stats: string, game: string, kind: string, avatar: string }
export struct TwitchRecent { query: string }
// `status` reads "2 new videos" or "Up to date", and `fresh` is set when there are new ones.
export struct TwitchFollow { login: string, name: string, picture: string, initials: string, tone: color, status: string, fresh: bool }

export struct ChatImage { label: string, url: string }
export struct ChatRow { id: string, author: string, color: color, time: string, text: string, badges: string, badge-images: [ChatImage], emotes: [ChatImage] }

export global AppState {
