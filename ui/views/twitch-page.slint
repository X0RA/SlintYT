import { ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { SearchBar } from "../components/search-bar.slint";
import { TwitchLanding, SectionHeading, HeadingLink } from "../components/twitch-landing.slint";
import { TwitchChannelCard } from "../components/twitch-channel-card.slint";
import { TwitchVideoCard } from "../components/twitch-video-card.slint";
import { TwitchRecentMenu } from "../components/twitch-recent-menu.slint";
import { TwitchFilterBar } from "../components/twitch-filter-bar.slint";
import { TwitchUserPage } from "twitch-user-page.slint";
component TwitchSearch inherits Rectangle {
    private property <bool> landing: AppState.twitch-results-query == "";
    private property <string> text: AppState.twitch-search-text;
    private property <int> columns: max(1, min(4, floor((root.width + 20px) / 310px)));
    private property <length> card-width: floor((results.visible-width - (root.columns - 1) * 20px) / root.columns / 1px) * 1px;
    changed columns => { AppState.twitch-columns = root.columns; }
    changed text => {
        AppState.twitch-recent-refresh();
        if root.text == "" && !root.landing { AppState.twitch-clear-search(); }
    }
    init => { AppState.twitch-columns = root.columns; AppState.twitch-landing-refresh(); }
    function search(query: string) {
        if query == "" { return; }
        twitch-search.blur();
        AppState.twitch-search-text = query;
        results.content-y = 0px;
        AppState.twitch-search(query);
    }
    Timer {
        interval: 250ms;
        running: !root.landing && !AppState.twitch-busy && !AppState.twitch-channels-busy
            && -results.content-y + results.visible-height >= results.content-height - 900px;
        triggered => {
            if AppState.twitch-results-tab != 1 && AppState.twitch-error == "" && AppState.twitch-cursor != "" { AppState.twitch-load-more(); }
            if AppState.twitch-results-tab == 1 && AppState.twitch-channels-error == "" && AppState.twitch-channel-cursor != "" { AppState.twitch-load-more-channels(); }
        }
    }
    VerticalLayout { padding-top: 24px; spacing: 16px;
        HorizontalLayout { height: 48px; alignment: center;
            twitch-search := SearchBar { width: min(600px, root.width - 24px); placeholder: "Search Twitch"; text <=> AppState.twitch-search-text; submitted(query) => { root.search(query); } }
        }
        if !root.landing : TwitchFilterBar { changed => { results.content-y = 0px; AppState.twitch-sort-changed(); } }
        results := ScrollView {
            vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                width: results.visible-width;
                padding-bottom: 32px; spacing: 16px; alignment: start;
                if root.landing : TwitchLanding { columns: root.columns; card-width: root.card-width; }
                if !root.landing && AppState.twitch-results-tab != 2 : VerticalLayout { spacing: 12px;
                    HorizontalLayout {
                        SectionHeading { text: "Channels"; count: AppState.twitch-channel-total > 0 ? AppState.twitch-channel-total + " results" : ""; }
                        if AppState.twitch-results-tab == 0 && AppState.twitch-channels.length > root.columns * 2 : HeadingLink {
                            text: "See all"; clicked => { AppState.twitch-results-tab = 1; AppState.twitch-sort = 0; AppState.twitch-sort-changed(); }
                        }
                    }
                    FlexboxLayout { spacing: 20px;
                        for item[index] in AppState.twitch-channels : Rectangle {
                            visible: AppState.twitch-results-tab == 1 || index < root.columns * 2;
                            width: self.visible ? root.card-width : 0px; height: self.visible ? 76px : 0px;
                            TwitchChannelCard { item: item; activate => { twitch-search.blur(); AppState.twitch-open-user(item); } }
                        }
                    }
                    if AppState.twitch-channels-error != "" : Text { text: AppState.twitch-channels-error; color: #ffaaa5; font-size: 14px; wrap: word-wrap; }
                    if AppState.twitch-channels-busy : Spinner { width: 24px; height: 24px; }
                    if !AppState.twitch-channels-busy && AppState.twitch-channels-error == "" && AppState.twitch-channels.length == 0 : Text { text: "No channels found."; color: Theme.muted; font-size: 14px; }
                }
                if !root.landing && AppState.twitch-results-tab != 1 : VerticalLayout { spacing: 12px;
                    SectionHeading { text: "Videos"; count: AppState.twitch-video-total > 0 ? AppState.twitch-video-total + " results" : ""; }
                    Rectangle {
                        height: ceil(AppState.twitch-results.length / root.columns) * (round(root.card-width * 9 / 16 / 1px) * 1px + 39px + 24px) - (AppState.twitch-results.length > 0 ? 24px : 0px);
                        for item[index] in AppState.twitch-results : TwitchVideoCard {
                            x: mod(index, root.columns) * (root.card-width + 20px);
                            y: floor(index / root.columns) * (self.height + 24px);
                            width: root.card-width; item: item;
                            activate => { twitch-search.blur(); AppState.twitch-play(item.id, item.title, item.channel); }
                        }
                    }
                    if AppState.twitch-busy : Spinner { width: 24px; height: 24px; }
                    if !AppState.twitch-busy && AppState.twitch-error == "" && AppState.twitch-results.length == 0 : Text { text: AppState.twitch-length > 0 ? "No loaded videos match this length. More results load as you scroll." : "No videos found."; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                }
                if !root.landing && AppState.twitch-error != "" : Text { text: AppState.twitch-error; color: #ffaaa5; font-size: 14px; wrap: word-wrap; }
            }
        }
    }
    if twitch-search.focused && AppState.twitch-recent.length > 0 : twitch-recent-dismiss := TouchArea {
        y: 78px; height: root.height - self.y; clicked => { twitch-search.blur(); }
    }
    // Last in the tree so suggestions float over the page content.
    if twitch-search.focused && AppState.twitch-recent.length > 0 : TwitchRecentMenu {
        x: twitch-search.absolute-position.x - root.absolute-position.x;
        y: 78px; width: twitch-search.width;
        picked(query) => { root.search(query); }
    }
}
export component TwitchPage inherits Rectangle {
    background: Theme.background;
    if !AppState.twitch-user-open : TwitchSearch {}
    if AppState.twitch-user-open : TwitchUserPage {}
}
